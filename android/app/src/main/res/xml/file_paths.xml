<?xml version="1.0" encoding="utf-8"?>
<!-- Only what the user asked to open or share; nothing else is shareable. -->
<paths>
    <cache-path name="open" path="open/" />
    <!-- Where the system camera writes a photo for us; deleted once it is encrypted. -->
    <cache-path name="camera" path="camera/" />
    <!-- Your contact code as a QR image, when you share it. -->
    <cache-path name="share" path="share/" />
</paths>
